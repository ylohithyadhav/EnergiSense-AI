# EnergiSense AI - Frontend Environment Configuration

# Public Backend API URL
# For local development: http://127.0.0.1:8000
# For production Render Web Service: https://energisense-ai-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Firebase Web App Configuration (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
