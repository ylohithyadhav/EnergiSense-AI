# ==============================================================================
# EnergiSense AI - Frontend Environment Variable Template
# ==============================================================================
# Copy this file to '.env' inside the 'frontend' folder:
#   Windows PowerShell: Copy-Item .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Frontend variables MUST start with 'VITE_' to be visible to Vite and React.
# 2. NEVER put private service account keys or private certificates here.
# 3. Only put client-side Firebase web configuration parameters here.
# ==============================================================================

# Public Backend API URL
# Local development default: http://127.0.0.1:8000
# Production Render URL: https://your-service-name.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Firebase Web App Client Configuration
# ------------------------------------------------------------------------------
# WHERE TO OBTAIN THESE VALUES:
# 1. Open Firebase Console: https://console.firebase.google.com
# 2. Select your project: "EnergiSense AI"
# 3. Click the gear icon (⚙️) next to "Project Overview" -> Select "Project settings"
# 4. Scroll down to the "Your apps" section:
#      - If no web app exists, click the Web icon (</>) to create one.
#      - Register app name: "EnergiSense AI Web" (do NOT enable Firebase Hosting yet).
# 5. Under "Firebase SDK snippet", select the "Config" radio button.
# 6. You will see a JavaScript object with keys matching the variables below:
#      const firebaseConfig = {
#        apiKey: "AIzaSy...",
#        authDomain: "your-project.firebaseapp.com",
#        projectId: "your-project",
#        storageBucket: "your-project.appspot.com",
#        messagingSenderId: "1234567890",
#        appId: "1:1234567890:web:abcdef..."
#      };
# 7. Copy each value directly to the corresponding variable below:

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
