# ==============================================================================
# EnergiSense AI - Backend Environment Variable Template
# ==============================================================================
# Copy this file to '.env' inside the 'backend' folder:
#   Windows PowerShell: Copy-Item .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual '.env' or 'serviceAccountKey.json' file to Git.
# 2. NEVER put service account keys or private keys into frontend code.
# ==============================================================================

# Server Runtime Environment (development | production)
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated list of URLs permitted to call the API)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-firebase-app.web.app,https://your-firebase-app.firebaseapp.com

# Maximum CSV Upload Size in Megabytes (default: 50 MB)
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# WHERE TO OBTAIN THESE VALUES:
# 1. Open Firebase Console: https://console.firebase.google.com
# 2. Select your project: "EnergiSense AI"
# 3. Click the gear icon (⚙️) next to "Project Overview" -> Select "Project settings"
# 4. Under the "General" tab, locate:
#      - Project ID: copy into FIREBASE_PROJECT_ID below.
# 5. Switch to the "Service accounts" tab.
# 6. Click "Generate new private key", then confirm "Generate key".
# 7. A JSON file will download (e.g., energisense-ai-firebase-adminsdk-xxxxx.json).
# 8. Rename the downloaded file to 'serviceAccountKey.json' and place it in 'backend/'.
# 9. Set FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json below.
#
# OPTION A: File Path (Recommended for local development)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# OPTION B: JSON String (Alternative for Render / Cloud hosting environment variables)
# (Copy all text from serviceAccountKey.json into a single line if using Render environment secrets)
FIREBASE_CREDENTIALS_JSON=
