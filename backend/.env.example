# EnergiSense AI - Backend Environment Configuration

# Service settings
ENVIRONMENT=production
ALLOWED_ORIGINS=https://energisense-ai.web.app,https://energisense-ai.firebaseapp.com,http://localhost:5173
MAX_UPLOAD_SIZE_MB=50

# Firebase Admin SDK Configuration
# Option A: In production on Render/Cloud, provide the project ID and path to service account key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# (Leave blank for local demo/unauthenticated development)
